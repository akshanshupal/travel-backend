<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Travel Connect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#202124;--muted:#73737b;--purple:#5d20bd;--purple-2:#7d35d7;--lav:#f3efff;--line:#e8e6ee;--bg:#f7f7f9;--green:#29bf68;--orange:#ff9f43;--red:#ff4e4e}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif}button,input{font:inherit}button{cursor:pointer;border:0;background:none;color:inherit}.app{min-height:100vh;display:grid;grid-template-columns:230px 1fr}.sidebar{background:#fff;border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:10px;padding:0 10px 26px;font-weight:700;font-family:'Space Grotesk';font-size:17px;white-space:nowrap;overflow:hidden}.brand-mark{width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,#6d1ecc,#b78aff);display:grid;place-items:center;color:#fff;font-weight:700}.workspace{font-size:13px;color:var(--muted);padding:0 12px 12px}.nav{display:grid;gap:4px}.nav a{display:flex;align-items:center;gap:13px;text-decoration:none;color:#575761;padding:12px 12px;border-radius:8px;font-size:14px}.nav a:hover,.nav a.active{background:var(--lav);color:var(--purple);font-weight:700}.nav-icon{width:22px;text-align:center;font-size:18px}.refer{margin-top:auto;padding:13px;color:#65656e;font-size:14px}.main{min-width:0}.topbar{height:64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:flex-end;gap:22px;padding:0 28px;color:#60616a}.top-icon{font-size:20px;position:relative}.badge{position:absolute;right:-9px;top:-8px;background:#d52d2d;color:#fff;font-size:10px;border-radius:12px;padding:2px 5px}.page{padding:28px 34px 44px;max-width:1500px;margin:auto}.page-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;color:var(--purple);font-weight:700}.title{font:700 30px 'Space Grotesk';margin:5px 0}.subtitle{color:var(--muted);font-size:14px}.actions{display:flex;gap:10px}.btn{padding:11px 16px;border-radius:9px;border:1px solid var(--line);background:#fff;font-weight:600;color:#555}.btn.primary{background:var(--purple);border-color:var(--purple);color:#fff}.search-row{display:flex;gap:12px;margin-bottom:22px}.search{flex:1;background:#fff;border:1px solid var(--line);border-radius:9px;padding:13px 15px;outline:none}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:20px;box-shadow:0 5px 15px rgba(39,25,71,.035)}.stat-label{font-size:13px;color:var(--muted)}.stat-value{font:700 28px 'Space Grotesk';margin-top:8px}.trend{color:var(--green);font-size:12px;margin-top:8px}.panel{margin-top:20px}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.panel-title{font:600 18px 'Space Grotesk'}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:640px}.table th,.table td{text-align:left;padding:15px 12px;border-bottom:1px solid var(--line);font-size:13px}.table th{color:var(--muted);font-weight:500}.person{display:flex;align-items:center;gap:10px;font-weight:600}.avatar{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#e9ddff;color:var(--purple);font-size:12px}.pill{display:inline-flex;padding:5px 9px;border-radius:20px;font-size:11px;font-weight:700}.pill.green{background:#e5f8ed;color:#138546}.pill.orange{background:#fff1df;color:#b36a11}.pill.red{background:#ffe7e7;color:#bd3030}.dial-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:20px}.dial-card{background:linear-gradient(145deg,#5520b6,#7e37d6);color:#fff;border-radius:16px;padding:26px;min-height:260px}.dial-number{font:700 42px 'Space Grotesk';letter-spacing:.04em;margin:28px 0}.dial-controls{display:flex;gap:10px}.dial-controls button{background:#fff;color:var(--purple);padding:12px 17px;border-radius:9px;font-weight:700}.timeline{display:grid;gap:14px}.event{display:flex;gap:12px}.dot{width:11px;height:11px;margin-top:5px;border-radius:50%;background:var(--purple)}.event small{color:var(--muted)}.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:18px}.tab{padding:12px 18px;color:var(--muted);font-size:13px}.tab.active{color:var(--purple);border-bottom:2px solid var(--purple);font-weight:700}.toast{position:fixed;right:25px;bottom:24px;background:#242029;color:#fff;padding:13px 17px;border-radius:10px;display:none}
    .lead-modal{position:fixed;inset:0;background:rgba(32,32,36,.42);display:none;align-items:center;justify-content:center;padding:28px;z-index:20}.lead-modal.open{display:flex}.lead-dialog{width:min(1240px,96vw);height:min(820px,92vh);overflow:auto;background:#fff;border-radius:18px;box-shadow:0 24px 70px rgba(31,20,54,.28)}.lead-top{height:74px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:center;position:sticky;top:0;background:#fff;z-index:2}.lead-tabs{height:100%;display:flex;gap:0}.lead-tab{min-width:185px;padding:0 22px;color:#777;font-weight:700;font-size:15px;letter-spacing:.01em}.lead-tab.active{color:#555;border-bottom:3px solid #4d5dd2}.lead-actions{position:absolute;right:20px;display:flex;gap:10px;align-items:center}.lead-actions button{height:42px;border:1px solid #dedbe5;border-radius:22px;padding:0 18px;color:var(--purple);font-weight:700;background:#fff}.lead-actions .icon{width:42px;padding:0;font-size:24px}.lead-body{padding:28px 30px 38px}.lead-hero{display:grid;grid-template-columns:1fr 1.15fr 1fr;gap:18px}.lead-card{min-height:122px;border:1px solid #e7e4eb;border-radius:16px;box-shadow:0 7px 18px rgba(30,20,45,.12);padding:24px;text-align:center}.lead-card label{display:block;color:var(--purple);font-size:13px;font-weight:700}.lead-card strong{display:block;color:var(--purple);font:700 22px 'Space Grotesk';margin-top:5px}.lead-card.call-card{background:linear-gradient(135deg,#5c1dbd,#7027c9);color:#fff;display:flex;flex-direction:column;justify-content:center}.lead-card.call-card label,.lead-card.call-card strong{color:#fff}.lead-number{font:700 25px 'Space Grotesk';margin-top:9px}.lead-call-row{display:flex;align-items:center;justify-content:center;gap:18px}.lead-call-row button{color:#fff;font-size:25px}.message-buttons{display:flex;justify-content:center;gap:14px;margin-top:12px}.message-buttons button{width:58px;height:52px;border:1px solid #dedbe5;border-radius:10px;font-size:24px;background:#fff}.lead-section{border:1px solid #e3e0e6;border-radius:12px;margin-top:28px;padding:22px 28px}.lead-section-title{font:500 18px 'Space Grotesk';color:var(--purple);display:flex;justify-content:space-between;align-items:center}.lead-details-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:20px}.lead-details-panel{border:1px solid #e3e0e6;border-radius:12px;padding:22px}.lead-details-panel h3{margin:0 0 18px;font:600 18px 'Space Grotesk';padding-bottom:16px;border-bottom:1px solid var(--line)}.detail-row{display:grid;grid-template-columns:1fr 1.5fr;gap:14px;padding:10px 0;color:#666;font-size:14px}.detail-row strong{color:#3d3d43}.history-row{display:grid;grid-template-columns:105px 28px 1fr;gap:10px;align-items:start;padding:12px 0;border-bottom:1px solid #f0eef2}.history-date{font-size:12px;background:#f5f4f5;padding:6px 8px;border-radius:5px}.history-dot{width:26px;height:26px;border-radius:50%;background:#eee1ff;color:var(--purple);display:grid;place-items:center}.history-row small{color:#777}.dispose-panel{display:none;padding:28px;font-size:14px;color:var(--muted)}.lead-modal[data-tab='dispose'] .lead-info-panel,.lead-modal[data-tab='other'] .lead-info-panel{display:none}.lead-modal[data-tab='dispose'] .dispose-panel,.lead-modal[data-tab='other'] .dispose-panel{display:block}.lead-modal[data-tab='dispose'] .dispose-panel:before{content:'Choose a call outcome, add a remark, and save the lead disposition.'}.lead-modal[data-tab='other'] .dispose-panel:before{content:'Additional lead actions and notes will appear here.'}
    @media(max-width:900px){.app{grid-template-columns:72px 1fr}.brand span,.workspace,.nav a span,.refer{display:none}.brand{justify-content:center;padding:0 0 26px}.nav a{justify-content:center}.page{padding:24px 18px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.dial-layout{grid-template-columns:1fr}}
    @media(max-width:560px){.topbar{padding:0 15px}.page-head{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.title{font-size:26px}}
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar"><div class="brand"><div class="brand-mark">T</div><span>Travel Connect</span></div><div class="workspace">HOSPITALITY GROUP</div><nav class="nav" id="nav"><a href="/dial/home" data-page="home"><b class="nav-icon">⌂</b><span>Home</span></a><a href="/dial/mycampaigns" data-page="campaigns"><b class="nav-icon">◈</b><span>My Campaigns</span></a><a href="/dial/leads" data-page="leads"><b class="nav-icon">♙</b><span>My Leads</span></a><a href="/dial/neo-whatsapp" data-page="whatsapp"><b class="nav-icon">◉</b><span>Neo WhatsApp</span></a><a href="/dial/walk-in-leads" data-page="walkins"><b class="nav-icon">⌁</b><span>Walk-in Leads</span></a><a href="/dial/call-logs" data-page="logs"><b class="nav-icon">◔</b><span>Call Logs</span></a><a href="/dial/report" data-page="reports"><b class="nav-icon">⌁</b><span>Reports</span></a></nav><div class="refer">♧ &nbsp; Refer & Earn</div></aside>
  <main class="main"><header class="topbar"><button class="top-icon" title="Headset">♧</button><button class="top-icon" title="Messages">□</button><button class="top-icon" title="Notifications">♧<i class="badge">5</i></button><button class="top-icon" title="Sync">⇄</button><button class="top-icon" title="Menu">☰</button></header><section class="page" id="content"></section></main>
</div><div class="toast" id="toast"></div>
<div class="lead-modal" id="lead-modal" data-tab="info" role="dialog" aria-modal="true" aria-label="Lead information"><div class="lead-dialog"><div class="lead-top"><div class="lead-tabs"><button class="lead-tab active" data-tab="info" onclick="switchLeadTab('info')">LEAD INFORMATION</button><button class="lead-tab" data-tab="dispose" onclick="switchLeadTab('dispose')">DISPOSE LEAD</button><button class="lead-tab" data-tab="other" onclick="switchLeadTab('other')">OTHER</button></div><div class="lead-actions"><button class="icon" onclick="closeLead()" aria-label="Close lead popup">−</button><button onclick="notify('Break started')">☕ BREAK</button><button class="icon" onclick="notify('More lead actions')" aria-label="More actions">⋮</button></div></div><div class="lead-body"><div class="lead-info-panel"><div class="lead-hero"><div class="lead-card"><label>Contact Name:</label><strong id="modal-name">punit kumar</strong></div><div class="lead-card call-card"><label>Call on this number</label><div class="lead-call-row"><button onclick="notify('Number copied')">▣</button><div class="lead-number" id="modal-phone">9599636543</div><button onclick="notify('Editing phone number')">✎</button></div><button style="margin-top:8px;color:#fff;font-weight:600" onclick="notify('Calling '+document.getElementById('modal-name').textContent+'…')">☎ Start call</button></div><div class="lead-card"><label>Send Message:</label><div class="message-buttons"><button onclick="notify('Opening WhatsApp')" aria-label="Send WhatsApp">◉</button><button onclick="notify('Opening email')" aria-label="Send email">✉</button><button onclick="notify('Opening SMS')" aria-label="Send SMS">☷</button></div></div></div><div class="lead-section"><div class="lead-section-title">Deal Amount <button class="btn" onclick="notify('Editing deal amount')">✎</button></div></div><div class="lead-section"><div class="lead-section-title" style="color:#444;justify-content:flex-start">Lead Details</div><div class="lead-details-grid"><div class="lead-details-panel"><h3>About</h3><h4>Basic Details &nbsp; ✎　⌃</h4><div class="detail-row"><span>Lead Name:</span><strong id="detail-name">punit kumar</strong></div><div class="detail-row"><span>Email Address:</span><strong>punitkumar25887@gmail.com</strong></div><div class="detail-row"><span>Mobile Number:</span><strong id="detail-phone">9599636543</strong></div><div class="detail-row"><span>Alternate Number:</span><strong>—</strong></div><div class="detail-row"><span>Creation Time:</span><strong>19 Nov 2024 05:02 PM</strong></div><h4>Lead Progress &nbsp; ✎　⌃</h4><div class="detail-row"><span>Status:</span><strong style="color:#ff7800">In-Progress</strong></div></div><div class="lead-details-panel"><h3>Timeline</h3><div style="display:flex;justify-content:space-between;align-items:center"><h4>Contact History</h4><button class="btn" onclick="notify('Showing full history')">View</button></div><div class="history-row"><span class="history-date">18 Sep 2026</span><span class="history-dot" style="background:#ffe0e0;color:red">✎</span><div><strong>Lead Disposed | Not Connected | 4:36 PM</strong><br><small>OPEN</small></div></div><div class="history-row"><span class="history-date">19 Nov 2024</span><span class="history-dot">♙</span><div><strong>Lead Created | Source: Copy Lead | 5:02 PM</strong></div></div></div></div></div></div><div class="dispose-panel"></div></div></div></div>
<script>
const path=location.pathname; const key=path.includes('mycampaigns')?'campaigns':path.includes('leads')?'leads':path.includes('neo-whatsapp')?'whatsapp':path.includes('walk-in')?'walkins':path.includes('call-logs')?'logs':path.includes('report')?'reports':'home';
const leads=[['Najbula','8509181630','In Progress','green'],['Arjun Mehta','9810023456','New','orange'],['Riya Sharma','9876543210','Contacted','green'],['Vikram Singh','9123456780','Open','orange']];
const content=document.getElementById('content');
function head(kicker,title,sub,button){return `<div class="page-head"><div><div class="eyebrow">${kicker}</div><h1 class="title">${title}</h1><div class="subtitle">${sub}</div></div>${button?`<div class="actions"><button class="btn primary" onclick="notify('${button}')">＋ ${button}</button></div>`:''}</div>`}
function table(rows=leads){return `<div class="card table-wrap"><table class="table"><thead><tr><th>Contact</th><th>Phone</th><th>Status</th><th>Last activity</th><th>Action</th></tr></thead><tbody>${rows.map((r,i)=>`<tr><td><div class="person"><span class="avatar">${r[0][0]}</span>${r[0]}</div></td><td>${r[1]}</td><td><span class="pill ${r[3]}">${r[2]}</span></td><td>${i+1} day${i?'s':''} ago</td><td><button class="btn" onclick="openLead('${r[0]}','${r[1]}')">View</button></td></tr>`).join('')}</tbody></table></div>`}
function render(){document.querySelectorAll('#nav a').forEach(a=>a.classList.toggle('active',a.dataset.page===key)); if(key==='home') content.innerHTML=head('DIAL CENTER','Good morning, Akshanshu','Your calling workspace is ready. Pick a lead and keep the conversation moving.','Add lead')+`<div class="grid"><div class="card"><div class="stat-label">Calls today</div><div class="stat-value">48</div><div class="trend">↑ 12% from yesterday</div></div><div class="card"><div class="stat-label">Connected</div><div class="stat-value">31</div><div class="trend">64.5% connection rate</div></div><div class="card"><div class="stat-label">Open leads</div><div class="stat-value">126</div><div class="trend">18 need follow-up</div></div><div class="card"><div class="stat-label">Talk time</div><div class="stat-value">3h 24m</div><div class="trend">↑ 24m this week</div></div></div><div class="dial-layout"><div class="panel card"><div class="panel-head"><div class="panel-title">Next lead</div><button class="btn" onclick="openLead('Najbula','8509181630')">Open profile</button></div><div class="dial-card"><div class="stat-label" style="color:#e2d7ff">READY TO CALL</div><div class="dial-number">850 918 1630</div><div class="dial-controls"><button onclick="openLead('Najbula','8509181630')">☎ Call now</button><button onclick="notify('Lead skipped')">Skip</button></div></div></div><div class="panel card"><div class="panel-head"><div class="panel-title">Recent activity</div><button class="btn">View all</button></div><div class="timeline"><div class="event"><i class="dot"></i><div><b>Lead disposed</b><br><small>Najbula · Connected · Today, 12:23 AM</small></div></div><div class="event"><i class="dot" style="background:var(--green)"></i><div><b>New lead assigned</b><br><small>Arjun Mehta · Yesterday</small></div></div><div class="event"><i class="dot" style="background:var(--orange)"></i><div><b>Follow-up due</b><br><small>Riya Sharma · Tomorrow</small></div></div></div></div></div>`; else if(key==='leads') content.innerHTML=head('CONTACTS','My leads','Search, call and manage the people in your pipeline.','Import leads')+`<div class="search-row"><input class="search" placeholder="Search by contact number or name" oninput="filterLeads(this.value)"><button class="btn">☷ Filters</button></div><div id="lead-table">${table()}</div>`; else if(key==='campaigns') content.innerHTML=head('WORK QUEUE','My campaigns','Keep every outreach campaign moving from one place.','New campaign')+`<div class="grid"><div class="card"><div class="stat-label">Active campaigns</div><div class="stat-value">6</div><div class="trend">2 launching this week</div></div><div class="card"><div class="stat-label">Leads in queue</div><div class="stat-value">1,284</div><div class="trend">↑ 8.2% this month</div></div><div class="card"><div class="stat-label">Conversion</div><div class="stat-value">18.6%</div><div class="trend">↑ 2.4% this month</div></div></div><div class="panel card">${table([['Summer Escapes','1,284 leads','Running','green'],['Corporate Retreats','428 leads','Paused','orange'],['Winter Packages','96 leads','Draft','orange']])}</div>`; else if(key==='whatsapp') content.innerHTML=head('MESSAGING','Neo WhatsApp','Reply to travel enquiries without leaving your workspace.','New message')+`<div class="dial-layout"><div class="card"><div class="panel-title">Conversations</div><div class="timeline" style="margin-top:20px"><div class="event"><span class="avatar">N</span><div><b>Najbula</b><br><small>Can you share the late checkout options?</small></div></div><div class="event"><span class="avatar">A</span><div><b>Arjun Mehta</b><br><small>Thanks, I’ll confirm the dates.</small></div></div></div></div><div class="card"><div class="panel-title">Select a conversation</div><p class="subtitle">Choose a contact to view messages and send a reply.</p></div></div>`; else if(key==='walkins') content.innerHTML=head('IN PERSON','Walk-in leads','Capture and follow up with guests who visit your desk.','Add walk-in')+table([['Meera Kapoor','9988776655','New','orange'],['Rahul Verma','8899776655','Follow-up','green']]); else if(key==='logs') content.innerHTML=head('CALL HISTORY','Call logs','A clear record of every conversation and outcome.')+`<div class="search-row"><input class="search" placeholder="Search call logs"><button class="btn">Date range</button></div>`+table([['Najbula','8509181630','Connected','green'],['Arjun Mehta','9810023456','Not connected','red'],['Riya Sharma','9876543210','Connected','green']]); else content.innerHTML=head('INSIGHTS','Reports','See how your team is performing across every outreach channel.','Export report')+`<div class="grid"><div class="card"><div class="stat-label">Total calls</div><div class="stat-value">2,840</div><div class="trend">↑ 16.4%</div></div><div class="card"><div class="stat-label">Avg. talk time</div><div class="stat-value">4m 12s</div><div class="trend">↑ 8.1%</div></div><div class="card"><div class="stat-label">Success rate</div><div class="stat-value">72.8%</div><div class="trend">↑ 4.6%</div></div></div><div class="panel card"><div class="panel-head"><div class="panel-title">Weekly performance</div><div class="tabs"><button class="tab active">Calls</button><button class="tab">Conversions</button></div></div><div style="height:180px;display:flex;align-items:end;gap:12px;padding:20px 10px;background:linear-gradient(to top,#faf8ff,transparent);border-radius:10px">${[42,68,52,88,73,96,80].map((h,i)=>`<div style="height:${h}%;flex:1;background:linear-gradient(#7e37d6,#c2a3f5);border-radius:6px 6px 0 0" title="${h} calls"></div>`).join('')}</div></div>`}
function notify(text){const t=document.getElementById('toast');t.textContent=text;t.style.display='block';setTimeout(()=>t.style.display='none',2200)} function openLead(name,phone){document.getElementById('modal-name').textContent=name;document.getElementById('modal-phone').textContent=phone;document.getElementById('detail-name').textContent=name;document.getElementById('detail-phone').textContent=phone;switchLeadTab('info');document.getElementById('lead-modal').classList.add('open');document.body.style.overflow='hidden'} function closeLead(){document.getElementById('lead-modal').classList.remove('open');document.body.style.overflow=''} function switchLeadTab(tab){const modal=document.getElementById('lead-modal');modal.dataset.tab=tab;document.querySelectorAll('.lead-tab').forEach(button=>button.classList.toggle('active',button.dataset.tab===tab))} document.getElementById('lead-modal').addEventListener('click',event=>{if(event.target.id==='lead-modal')closeLead()});document.addEventListener('keydown',event=>{if(event.key==='Escape')closeLead()}); function filterLeads(q){const filtered=leads.filter(r=>(r[0]+' '+r[1]).toLowerCase().includes(q.toLowerCase()));document.getElementById('lead-table').innerHTML=table(filtered)} render();
</script>
</body></html>